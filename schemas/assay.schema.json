{
  "$defs": {
    "AssayCategory": {
      "enum": [
        "BIOCHEMICAL",
        "MICROBIOLOGICAL",
        "CELLULAR",
        "ADME",
        "TOXICITY",
        "SELECTIVITY",
        "STRUCTURAL"
      ],
      "title": "AssayCategory",
      "type": "string"
    },
    "EndpointType": {
      "enum": [
        "IC50",
        "Ki",
        "Kd",
        "percent inhibition",
        "residual enzyme activity",
        "MIC",
        "MIC fold change",
        "fractional inhibitory concentration",
        "time-kill endpoint",
        "cytotoxicity",
        "solubility",
        "permeability",
        "metabolic stability",
        "human off-target inhibition"
      ],
      "title": "EndpointType",
      "type": "string"
    }
  },
